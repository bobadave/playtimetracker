# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

NODE_ENV=production

# Long random string that signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# The public URL this app is served at (used to build links in verification/reset emails).
APP_BASE_URL=https://tracker.yourdomain.com

# Port the app listens on. Nginx/Passenger proxies to this.
PORT=3000

# Outgoing mail (SMTP). Leave unset to fall back to console-logging email links instead of sending real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
